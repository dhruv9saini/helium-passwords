# Paths only. Keep the private age identity outside the repository.
version=1
source_device=da
profile=default
snapshot_store=/home/d/.local/share/helium-sync/tab-snapshots/da-default
state_root=/home/d/.local/state/helium-tab-ops
helium_tabs=/home/d/.local/bin/helium-tabs
exporter=/home/d/.local/libexec/helium-tab-exporter
browser_version=0.14.7
chromium_version=148.0.7778.178
interval_seconds=900
age_recipients=/home/d/.config/helium-sync/tab-backup-recipients.txt
age_identity=/run/helium-offline-recovery/tab-backup-identity.txt
destination_reserve_bytes=1073741824

# Exactly two distinct off-device hosts are required. For da, the second copy
# is d (or replace d with another genuinely independent host).
destination=nas-on-lm|ssh|lm|lm|/srv/nas/helium-tab-backups
destination=d-copy|ssh|d|d|/home/d/.local/share/helium-tab-backups
