version=1
source_device=d
profile=default
profile_root=/home/d/.config/helium
guard_path=/run/user/1000/helium-default.session.guard
store=/home/d/.local/share/helium-native-session-capsules/default
state_root=/home/d/.local/state/helium-native-session-capsules/default
capsule_cli=/home/d/.local/bin/helium-session-capsule
gpg_home=/home/d/.local/share/helium-native-session-capsules/gnupg
gpg_recipient_a=RAW_CAPSULE_NAS_RECOVERY_FINGERPRINT
gpg_recipient_b=RAW_CAPSULE_PEER_RECOVERY_FINGERPRINT
ssh_user=d
ssh_identity=/home/d/.ssh/helium-native-session-backup
ssh_known_hosts=/home/d/.ssh/helium-native-session-known-hosts
destination_a_host=lm
destination_a_root=/srv/nas/helium-tab-recovery
destination_b_host=da
destination_b_root=/home/d/.local/share/helium-tab-recovery
