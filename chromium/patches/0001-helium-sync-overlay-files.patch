+#if BUILDFLAG(IS_ANDROID)
+void AndroidBackendLog(const std::string& message) {
+  __android_log_write(ANDROID_LOG_WARN, "HeliumSync", message.c_str());
+}
+
+std::string ErrorSummary(const PasswordStoreBackendError& error) {
+  return "error=" + base::NumberToString(static_cast<int>(error.type));
+}
+
+std::string ResultSummary(const BackendLoginsResultOrError& result) {
+  if (std::holds_alternative<PasswordStoreBackendError>(result)) {
+    return ErrorSummary(std::get<PasswordStoreBackendError>(result));
+  }
+  return "count=" +
+         base::NumberToString(std::get<BackendLoginsResult>(result).size());
+}
+
+std::string ResultSummary(const PasswordChangesOrError& result) {
+  if (std::holds_alternative<PasswordStoreBackendError>(result)) {
+    return ErrorSummary(std::get<PasswordStoreBackendError>(result));
+  }
+  const PasswordChanges& changes = std::get<PasswordChanges>(result);
+  if (!changes) {
+    return "changes=null";
+  }
+  return "changes=" + base::NumberToString(changes->size());
+}
+
+template <typename Result>
+Result LogAndroidBackendResult(std::string method_name, Result result) {
+  AndroidBackendLog("backend " + method_name + " " + ResultSummary(result));
+  return result;
+}
+#endif
+
+// Template function to create a callback which accepts LoginsResultOrError or
+// PasswordChangesOrError as a result.
+template <typename Result>
+base::OnceCallback<Result(Result)> ReportMetricsForResultCallback(
+    MethodName method_name) {
+  PasswordStoreBackendMetricsRecorder metrics_reporter(
+      BackendInfix("BuiltInBackend"), method_name,
+      PasswordStoreBackendMetricsRecorder::PasswordStoreAndroidBackendType::
+          kNone);
+  return base::BindOnce(
+      [](PasswordStoreBackendMetricsRecorder reporter,
+         Result result) -> Result {
+        if (std::holds_alternative<PasswordStoreBackendError>(result)) {
+          reporter.RecordMetrics(SuccessStatus::kError,
+                                 std::get<PasswordStoreBackendError>(result));
+        } else {
+          reporter.RecordMetrics(SuccessStatus::kSuccess, std::nullopt);
+        }
+        return result;
+      },
+      std::move(metrics_reporter));
+}
+
+template <typename Result>
+base::OnceCallback<Result(Result)> LogAndroidBackendResultCallback(
+    MethodName method_name) {
+#if BUILDFLAG(IS_ANDROID)
+  return base::BindOnce(&LogAndroidBackendResult<Result>, method_name.value());
+#else
+  return base::BindOnce([](Result result) { return result; });
+#endif
+}
