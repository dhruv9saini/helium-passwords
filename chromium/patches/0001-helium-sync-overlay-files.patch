+void PasswordStoreBuiltInBackend::OnSyncShutdown(syncer::SyncService* sync) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(sync_observation_.IsObservingSource(sync));
+  sync_observation_.Reset();
+}
