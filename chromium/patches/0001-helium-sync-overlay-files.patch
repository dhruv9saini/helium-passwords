+          login_db->db_path());
+  DCHECK(background_task_runner_);
+  helper_ = std::make_unique<LoginDatabaseAsyncHelper>(
+      std::move(login_db), base::SequencedTaskRunner::GetCurrentDefault(),
+      wipe_model_upon_sync_disabled_behavior);
