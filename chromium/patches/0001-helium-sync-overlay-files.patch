+
+#ifndef COMPONENTS_HELIUM_SYNC_HELIUM_SYNC_CLIENT_H_
+#define COMPONENTS_HELIUM_SYNC_HELIUM_SYNC_CLIENT_H_
+
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
