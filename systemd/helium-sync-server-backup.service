[Unit]
Description=Create a verified opaque Helium Sync server backup
After=srv-nas.mount
RequiresMountsFor=/srv/nas
ConditionPathIsMountPoint=/srv/nas
ConditionPathIsDirectory=/srv/nas/helium-sync-server
ConditionPathExists=/var/lib/helium-sync/devices.json

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/helium-sync-server-backup backup /srv/nas/helium-sync-server
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=256M
MemorySwapMax=0
TasksMax=32
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/helium-sync
ReadWritePaths=/srv/nas/helium-sync-server
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
