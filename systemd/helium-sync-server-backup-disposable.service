[Unit]
Description=Back up synthetic disposable Helium Sync opaque state
ConditionPathIsMountPoint=/srv/nas
ConditionPathExists=%h/.local/state/helium-sync-disposable/SYNTHETIC_ONLY
ConditionPathExists=%h/.local/state/helium-sync-disposable/server/devices.json

[Service]
Type=oneshot
Environment=HELIUM_SERVER_DATA_DIR=%h/.local/state/helium-sync-disposable/server
Environment=HELIUM_SERVER_SERVICE=helium-syncd-disposable.service
Environment=HELIUM_SERVER_SERVICE_SCOPE=user
Environment=HELIUM_SYNC_CLI=%h/.local/share/helium-sync-disposable/bin/helium-sync
ExecStart=%h/.local/share/helium-sync-disposable/bin/helium-sync-server-backup backup /srv/nas/helium-sync-server-disposable
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=256M
MemorySwapMax=0
TasksMax=32
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/share/helium-sync-disposable/bin
BindReadOnlyPaths=%h/.local/state/helium-sync-disposable/server
BindPaths=/srv/nas/helium-sync-server-disposable
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
