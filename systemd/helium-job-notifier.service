[Unit]
Description=Record terminal Helium job state
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=d
Environment=HOME=/home/d
Environment=PATH=/home/d/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/home/d/.local/libexec/helium-job-notifier poll
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=10%
MemoryMax=128M
TasksMax=32
