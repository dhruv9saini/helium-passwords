[Unit]
Description=Helium Sync opaque ciphertext service
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=helium-sync
Group=helium-sync
EnvironmentFile=/etc/helium-sync/tls/current/endpoint.env
ExecStartPre=/usr/bin/test -s /var/lib/helium-sync/devices.json
ExecStartPre=/usr/bin/test ! -e /etc/helium-sync/tls/current/ca-key.pem
ExecStartPre=/usr/local/libexec/helium-sync-releases/current/helium-sync tls-server-verify --ca-cert /etc/helium-sync/tls/current/ca-cert.pem --server-cert /etc/helium-sync/tls/current/server-cert.pem --server-key /etc/helium-sync/tls/current/server-key.pem --hostname ${HELIUM_SYNC_TLS_HOSTNAME} --ip ${HELIUM_SYNC_TLS_IP} --minimum-validity 720h
ExecStart=/usr/local/libexec/helium-sync-releases/current/helium-syncd -listen ${HELIUM_SYNC_LISTEN} -tls-cert-file /etc/helium-sync/tls/current/server-cert.pem -tls-key-file /etc/helium-sync/tls/current/server-key.pem -data-dir /var/lib/helium-sync -devices-file /var/lib/helium-sync/devices.json
ExecStartPost=/usr/local/libexec/helium-sync-releases/current/helium-sync-endpoint-health
TimeoutStartSec=30s
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=100.64.0.0/10
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
StateDirectory=helium-sync
StateDirectoryMode=0700
ReadWritePaths=/var/lib/helium-sync
ReadOnlyPaths=/etc/helium-sync
MemoryMax=256M
MemorySwapMax=0
TasksMax=64

[Install]
WantedBy=multi-user.target
