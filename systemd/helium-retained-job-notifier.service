[Unit]
Description=Observe retained Helium transient builds on chromiumer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/home/d
Environment=PATH=/home/d/.local/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin
Environment=HELIUM_JOB_NOTIFY_STATE_ROOT=/home/d/.local/state/helium-retained-job-notifier
Environment=HELIUM_CHROMIUMER_REMOTE_WORKER=.local/libexec/helium-unit-terminal
ExecStart=/home/d/.local/libexec/helium-job-notifier poll
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=10%
MemoryMax=128M
TasksMax=32
