[Unit]
Description=Archive verified readable Helium Sync state as the service account

[Service]
Type=oneshot
User=helium-sync
Group=helium-sync
Environment=HELIUM_SERVER_SERVICE=none
Environment=HELIUM_SYNC_CLI=/usr/local/libexec/helium-sync-releases/current/helium-sync
ExecStart=/usr/local/libexec/helium-sync-releases/current/helium-sync-server-backup backup /srv/nas/helium-sync-server
TimeoutStartSec=15min
TimeoutStopSec=30s
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=256M
MemorySwapMax=0
TasksMax=32
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/helium-sync
ReadWritePaths=/srv/nas/helium-sync-server
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
