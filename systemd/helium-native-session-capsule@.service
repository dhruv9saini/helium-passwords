[Unit]
Description=Helium stopped native-session capsule attempt (%i)

[Service]
Type=oneshot
ExecStart=%h/.local/libexec/helium/native-session-capsule-backup.sh cycle %h/.config/helium/native-session-capsule-%i.conf
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/helium-native-session-capsules %h/.local/state/helium-native-session-capsules
