{
  "manifest_version": 3,
  "name": "Helium Google AI Overview Blocker",
  "description": "Hides Google AI Overview result blocks without changing Google result mode.",
  "version": "1.0.0",
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*"
      ],
      "js": [
        "hide-ai-overviews.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://www.google.com/*"
  ]
}
